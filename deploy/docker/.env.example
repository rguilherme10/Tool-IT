# Copie para .env (chmod 600) e preencha. NUNCA versionar o .env.
# Senhas: use geradores (ex.: openssl rand -base64 33). Evite os caracteres $ e " (o Compose interpola $).

# URL pública do Manager (HTTPS, o nome do certificado). O Agent usa exatamente este endereço.
APP_URL=https://toolit.empresa.local

# Gere com:  APP_KEY=temporaria docker compose run --rm --no-deps app php artisan key:generate --show
# GUARDE uma cópia FORA do servidor: sem ela, sessões e segredos TOTP cifrados são perdidos.
APP_KEY=

# MySQL
DB_PORT=3306
DB_DATABASE=toolit
DB_USERNAME=toolit
DB_PASSWORD=
DB_MIGRATE_USERNAME=toolit_migrator
DB_MIGRATE_PASSWORD=

# Redis
REDIS_PASSWORD=

# Portas publicadas no host
HTTPS_PORT=443
HTTP_PORT=80

# Opcionais
LOG_LEVEL=info
TOOLIT_AGENT_MIN_VERSION=0.1.0
TOOLIT_TAG=local
