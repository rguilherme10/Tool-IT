APP_NAME=Toolit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Banco de dados. Alvo de produção: MySQL 8.0+ (Laragon). SQLite só para desenvolvimento rápido.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=toolit
# DB_USERNAME=toolit      # usuário dedicado; em produção SEM UPDATE/DELETE em audit_logs (docs/deployment/server.md)
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessão, cache e fila. Produção (Laragon): Redis. Desenvolvimento sem Redis: database.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # true em produção (HTTPS)
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# CACHE_PREFIX=toolit

REDIS_CLIENT=phpredis        # ou predis, se a extensão phpredis não existir no PHP do Laragon
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="toolit@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Toolit
# ---------------------------------------------------------------------------
TOOLIT_REQUIRE_MFA_ADMINS=true
TOOLIT_AGENT_MIN_VERSION=0.1.0
TOOLIT_AGENT_SKEW=120
TOOLIT_AGENT_NONCE_TTL=300
TOOLIT_AGENT_RATE_LIMIT=120

VITE_APP_NAME="${APP_NAME}"
